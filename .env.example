# ─────────────────────────────────────────────────────────────────────────────
# Modèle de configuration locale (SANS secrets réels)
# Copier en .env puis remplacer les valeurs :  cp .env.example .env
# .env est ignoré par git — ne jamais committer de vraie valeur.
# Utilisé par docker-compose.local.yml.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL (conteneur local, exposé sur 127.0.0.1:5432 uniquement)
DB_USERNAME=eco
DB_PASSWORD=changez_moi
DB_NAME=eco_tourism

# Backend
PORT=3000
DB_HOST=localhost
DB_PORT=5432
MONGODB_URI=mongodb://localhost:27017/ecovoyage
JWT_SECRET=changez_moi_par_une_chaine_aleatoire
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Cloudinary (optionnel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (optionnel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
